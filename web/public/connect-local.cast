[11.934, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists):"]
[15.108, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-"]
[15.369, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4"]
[15.637, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit"]
[16.166, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit\r\nProbing \u2026"]
[17.21, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit\r\nProbing \u2026\r\n\u2713 local connected \u00b7 chat API \u00b7 6 models \u00b7 tested Qwen3.5-9B-MLX-4bit \u2192 \"ok\" \u00b7 kept in ~/.memdoor\r\n/providers.json\r\n  e.g. Qwen3.5-9B-MLX-4bit, Qwen3-0.6B-4bit, Qwen3-8B-4bit, Qwen3.5-0.8B-MLX-4bit, Qwen3.8-27B-4\r\nbit\r\n  pinned: new conversations start on local:Qwen3.5-9B-MLX-4bit. /model auto removes the pin.\r\n  /model <id> in the window pins one of its models; memdoor model search <name> finds them.\r\n  it judges too: kept as local-decisions, the decision model runs here with no key.\r\n\r\n\u2192 Next: memdoor --help   (see all commands)\r\n$"]
[41.234, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit\r\nProbing \u2026\r\n\u2713 local connected \u00b7 chat API \u00b7 6 models \u00b7 tested Qwen3.5-9B-MLX-4bit \u2192 \"ok\" \u00b7 kept in ~/.memdoor\r\n/providers.json\r\n  e.g. Qwen3.5-9B-MLX-4bit, Qwen3-0.6B-4bit, Qwen3-8B-4bit, Qwen3.5-0.8B-MLX-4bit, Qwen3.8-27B-4\r\nbit\r\n  pinned: new conversations start on local:Qwen3.5-9B-MLX-4bit. /model auto removes the pin.\r\n  /model <id> in the window pins one of its models; memdoor model search <name> finds them.\r\n  it judges too: kept as local-decisions, the decision model runs here with no key.\r\n\r\n\u2192 Next: memdoor --help   (see all commands)\r\n$ memd"]
[41.498, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit\r\nProbing \u2026\r\n\u2713 local connected \u00b7 chat API \u00b7 6 models \u00b7 tested Qwen3.5-9B-MLX-4bit \u2192 \"ok\" \u00b7 kept in ~/.memdoor\r\n/providers.json\r\n  e.g. Qwen3.5-9B-MLX-4bit, Qwen3-0.6B-4bit, Qwen3-8B-4bit, Qwen3.5-0.8B-MLX-4bit, Qwen3.8-27B-4\r\nbit\r\n  pinned: new conversations start on local:Qwen3.5-9B-MLX-4bit. /model auto removes the pin.\r\n  /model <id> in the window pins one of its models; memdoor model search <name> finds them.\r\n  it judges too: kept as local-decisions, the decision model runs here with no key.\r\n\r\n\u2192 Next: memdoor --help   (see all commands)\r\n$ memdoor model"]
[42.288, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]: 1\r\nA model to test with (blank: the first the provider lists): Qwen3.5-9B-MLX-4bit\r\nProbing \u2026\r\n\u2713 local connected \u00b7 chat API \u00b7 6 models \u00b7 tested Qwen3.5-9B-MLX-4bit \u2192 \"ok\" \u00b7 kept in ~/.memdoor\r\n/providers.json\r\n  e.g. Qwen3.5-9B-MLX-4bit, Qwen3-0.6B-4bit, Qwen3-8B-4bit, Qwen3.5-0.8B-MLX-4bit, Qwen3.8-27B-4\r\nbit\r\n  pinned: new conversations start on local:Qwen3.5-9B-MLX-4bit. /model auto removes the pin.\r\n  /model <id> in the window pins one of its models; memdoor model search <name> finds them.\r\n  it judges too: kept as local-decisions, the decision model runs here with no key.\r\n\r\n\u2192 Next: memdoor --help   (see all commands)\r\n$ memdoor model\r\ncoder      Qwen3.5-9B-MLX-4bit\r\n\r\n\u2192 Next: memdoor --help   (see all commands)\r\n$"]
