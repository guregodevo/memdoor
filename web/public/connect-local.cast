[3.434, "o", "\u001b[H\u001b[2J$ memdoor connect local\r\nModel servers running on this computer:\r\n  1. janis   http://localhost:8090/v1  6 models\r\n  2. Ollama  http://localhost:11434/v1  4 models\r\n  3. Another address\r\nNumber [1]:"]
