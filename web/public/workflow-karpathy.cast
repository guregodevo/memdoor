arget \u001b[38;5;179m\u001b[48;5;236mpython3 -c \"import json; assert json.load(open('reports/base\u2026\u001b[0m\r\n  \u001b[3m\u001b[38;5;245mpasses \u00b7 1 file changed \u00b7 \u001b[38;5;179m\u001b[48;5;236mPYTHONPATH=src python3 src/baselines.py 2>&1 | grep -vi warn\u2026\u001b[0m\r\n  \u001b[3m\u001b[38;5;245mFAIL \u00b7 \u001b[38;5;179m\u001b[48;5;236mPYTHONPATH=src python3 - <<'EOF' 2>\u001b]8;;file:///dev/null\u001b\\/dev/null\u001b[0m\u001b]8;;\u001b\\ PASS \u00b7 \u001b[38;5;179m\u001b[48;5;236mPYTHONPATH=src python3\u001b[39m\u001b[49m\r\n  \u001b[3m\u001b[38;5;245msrc/baselines.py 2>&1 | tail -4 && py\u2026\u001b[0m PASS\r\n\r\n  \u001b[3m\u001b[38;5;245m\u25b8 gpu-training-plan \u2014 \u2713 target plans/gpu-training.md exists \u00b7 1 file changed \u00b7 no build,\u001b[0m\r\n  \u001b[3m\u001b[38;5;245mtest or run after it\u001b[0m\r\n\r\n  \u001b[3m\u001b[38;5;245m\u25b8 regularize \u2014 \u2713 target \u001b[38;5;179m\u001b[48;5;236mpython3 -c \"import json; d=json.load(open('reports/regulariz\u2026\u001b[0m\r\n  \u001b[3m\u001b[38;5;245mpasses \u00b7 1 file changed \u00b7 \u001b[38;5;179m\u001b[48;5;236mpython3 src/regularize.py\u001b[0m FAIL \u00b7 \u001b[38;5;179m\u001b[48;5;236msed -i '' 's/xtr, _, xte, yte\u001b[39m\u001b[49m\r\n  \u001b[3m\u001b[38;5;245m= load_cifar10()/xtr, ytr, xte\u2026\u001b[0m PASS \u00b7 \u001b[38;5;179m\u001b[48;5;236mpython3 -c \"import json;\u001b[39m\u001b[49m\r\n  \u001b[3m\u001b[38;5;245md=json.load(open('reports/regulariz\u2026\u001b[0m PASS\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2