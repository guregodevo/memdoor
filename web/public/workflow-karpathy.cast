\u001b[38;5;245m\u25cb\u001b[39m skeleton                 \u001b[38;5;245mwaiting  \u2190 data-understanding\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m baselines                \u001b[38;5;245mwaiting  \u2190 skeleton\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m gpu-training-plan        \u001b[38;5;245mwaiting  \u2190 baselines\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m regularize               \u001b[38;5;245mwaiting  \u2190 baselines\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m tune                     \u001b[38;5;245mwaiting  \u2190 regularize\u001b[39m\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b[39m \u001b[37m> \u001b[39m\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b[39m  \u001b[38;5;109m\u2387 main\u001b[38;5;238m  \u00b7  \u001b[38;