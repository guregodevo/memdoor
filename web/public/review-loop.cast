[29.85, "o", "\u001b[H\u001b[2J\u001b[38;5;238m\u2502\u001b[39m   \u001b[38;5;108m\u2713\u001b[39m issue      \u001b[38;5;245mdone 0s\u001b[39m                                                                 \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m   \u001b[38;5;245m\u25cb\u001b[39m review     \u001b[38;5;245mwaiting \u00b7 external \u2014 a approves\u001b[39m                                         \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m \u001b[38;5;245m  \u2502\u001b[39m                                                                                    \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m   \u001b[38;5;108m\u2713\u001b[39m reproduce  \u001b[38;5;245mdone 40s  \u2190 issue, branch\u001b[39m                                               \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m       \u001b[38;5;245m\u2713 target `go vet ./... && ! go test -run 'TestIssue3' ./... >/dev/null\u2026` pass\u2026\u001b[39m   \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m \u001b[38;5;245m  \u2502\u001b[39m                                                                                    \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m   \u001b[38;5;108m\u2713\u001b[39m fix        \u001b[38;5;245mdone 13s  \u2190 reproduce\u001b[39m                                                   \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m       \u001b[38;5;245m\u2713 target `go vet ./... && go test -race ./... >/dev/null && go test -r\u2026` pass\u2026\u001b[39m   \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m \u001b[38;5;245m  \u2502\u001b[39m                                                                                    \u001b[38;5;238m\u2502\u001b[39m\r\n\u001b[38;5;238m\u2502\u001b[39m   \u001b[38;5;108m\u2713\u001b[39m pr         \u001b[38;5;245mdone 13s  \u2190 fix\u001b[39m                 