[12.1, "o", "\u001b[H\u001b[2J\r\n\u001b[1m\u001b[38;5;109m> \u001b[38;5;252m/workflow run ship ad864662\u001b[0m\r\n\r\n  \u001b[3m\u001b[38;5;245m\u25b6 ship \u00b7 11 tasks \u00b7 ship-20261005-123051\u001b[0m\r\n\r\n\u001b[48;5;238m \u001b[1m\u001b[38;5;252mcoder\u001b[0m\u001b[48;5;238m \u001b[49m\r\n  \u001b[92mlive\u001b[39m \u001b[1m\u001b[38;5;109maktapus\u001b[0m \u00b7 \u001b[3m\u001b[38;5;245mnew session\u001b[0m \u00b7 \u23f5\u23f5 auto                                   \u001b[38;5;245m7.9k/1032.2k \u00b7 1% ctx\u001b[39m\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b[39m  \u001b[38;5;245mship \u00b7 running \u00b7 6/11 done\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m approve  \u001b[38;5;245mwaiting \u00b7 external \u2014 a approves\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m clean    \u001b[38;5;245mdone 0s\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m build    \u001b[38;5;245mdone 9s  \u2190 clean\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m tests    \u001b[38;5;245mdone 15s  \u2190 clean\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m unused   \u001b[38;5;245mdone 4s  \u2190 clean\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m vet      \u001b[38;5;245mdone 1s  \u2190 clean\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m web      \u001b[38;5;245mdone 4s  \u2190 clean\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;179m\u25b6\u001b[39m