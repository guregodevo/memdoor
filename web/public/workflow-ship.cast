u2713\u001b[39m web      \u001b[38;5;245mdone 4s  \u2190 clean\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;108m\u2713\u001b[39m push     \u001b[38;5;245mdone 2s  \u2190 build, vet, tests, unused, web\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;179m\u25b6\u001b[39m deploy   \u001b[38;5;245mrunning 45s  \u2190 push, approve\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m verify   \u001b[38;5;245mwaiting  \u2190 deploy\u001b[39m\r\n\u001b[38;5;245m  \u2502\u001b[39m\r\n  \u001b[38;5;245m\u25cb\u001b[39m page     \u001b[38;5;245mwaiting  \u2190 verify\u001b[39m\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b[39m \u001b[37m> \u001b[39m\r\n\u001b[38;5;238m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\u001b[39m  \u001b[38;5;109m\u2387 main\u001b[38;5;238m  \u00b7  \u001b[38;5;245mdeepseek \u00b7 deepseek-flash\u001b[38;5;2