pseudo final:
import sys
from heapq import heappush, heappop

def solve():
    data = list(map(int, sys.stdin.buffer.read().split()))
    if not data:
        return
    n = data[0]
    # values at data[1..n]
    if n % 2 == 0:
        low = []
        high = []
        sl = 0
        sh = 0
        for idx in range(1, n + 1):
            x = data[idx]
            if not low or x <= -low[0]:
                heappush(low, -x)
                sl += x
            else:
                heappush(high, x)
                sh += x
            if len(low) > len(high):
                v = -heappop(low)
                sl -= v
                heappush(high, v)
                sh += v
            elif len(high) > len(low) + 1:
                v = heappop(high)
                sh -= v
                heappush(low, -v)
                sl += v
        print(sh - sl)
    else:
        suff = [0] * (n + 1)
        low = []
        high = []
        sl = 0
        sh = 0
        for idx in range(n, 0, -1):
            x = data[idx]
            if not low or x <= -low[0]:
                heappush(low, -x)
                sl += x
            else:
                heappush(high, x)
                sh += x
            if len(low) > len(high):
                v = -heappop(low)
                sl -= v
                heappush(high, v)
                sh += v
            elif len(high) > len(low) + 1:
                v = heappop(high)
                sh -= v
                heappush(low, -v)
                sl += v
            if ((n - idx + 1) & 1) == 0: # length = n - idx + 1
                suff[idx] = sh - sl
        # prefix scan first n-1 elements
        low = []
        high = []
        sl = 0
        sh = 0
        ans = suff[1]
        for idx in range(1, n):  # 1..n-1
            x = data[idx]
            if not low or x <= -low[0]:
                heappush(low, -x)
                sl += x
            else:
                heappush(high, x)
                sh += x
            if len(low) > len(high):
                v = -heappop(low)
                sl -= v
                heappush(high, v)
                sh += v
            elif len(high) > len(low) + 1:
                v = heappop(high)
                sh -= v
                heappush(low, -v)
                sl += v
            if ((idx) & 1) == 0: # prefix length idx (since data index idx corresponds a_idx 1-based length idx)
                cand = (sh - sl) + suff[idx + 1]
                if cand > ans:
                    ans = cand
        print(ans)

if __name__ == "__main__": solve()

