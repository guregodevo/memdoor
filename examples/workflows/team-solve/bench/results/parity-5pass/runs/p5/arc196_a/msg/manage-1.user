full code:
```
import sys
from heapq import heappush, heappop

def suffix_scores(a):
    n = len(a)
    suff = [0] * (n + 1)
    low = []
    high = []
    sl = 0
    sh = 0
    ls = 0
    hs = 0
    push = heappush
    pop = heappop
    for i in range(n - 1, -1, -1):
        x = a[i]
        if ls == 0 or x <= -low[0]:
            push(low, -x)
            sl += x
            ls += 1
        else:
            push(high, x)
            sh += x
            hs += 1
        if ls > hs + 1:
            v = -pop(low)
            sl -= v
            push(high, v)
            sh += v
            ls -= 1
            hs += 1
        elif hs > ls:
            v = pop(high)
            sh -= v
            push(low, -v)
            sl += v
            hs -= 1
            ls += 1
        if ((n - i) & 1) == 0:
            suff[i] = sh - sl
    return suff

def solve():
    data = list(map(int, sys.stdin.buffer.read().split()))
    if not data:
        return
    n = data[0]
    a = data[1:]
    del data
    suff = suffix_scores(a)
    if n % 2 == 0:
        print(suff[0])
        return
    low = []
    high = []
    sl = 0
    sh = 0
    ls = 0
    hs = 0
    push = heappush
    pop = heappop
    ans = suff[1]
    for i in range(n - 1):
        x = a[i]
        if ls == 0 or x <= -low[0]:
            push(low, -x)
            sl += x
            ls += 1
        else:
            push(high, x)
            sh += x
            hs += 1
        if ls > hs + 1:
            v = -pop(low)
            sl -= v
            push(high, v)
            sh += v
            ls -= 1
            hs += 1
        elif hs > ls:
            v = pop(high)
            sh -= v
            push(low, -v)
            sl += v
            hs -= 1
            ls += 1
        if ((i + 1) & 1) == 0:
            cand = (sh - sl) + suff[i + 2]
            if cand > ans:
                ans = cand
    print(ans)

if __name__ == "__main__":
    solve()
```

