```
import sys
from heapq import heappush, heappop

def solve():
    data = list(map(int, sys.stdin.buffer.read().split()))
    if not data:
        return
    n = data[0]
    a = data[1:]

    if n % 2 == 0:
        low = []
        high = []
        sl = sh = 0
        ls = hs = 0
        for x in a:
            if ls == 0 or x <= -low[0]:
                heappush(low, -x)
                sl += x
                ls += 1
            else:
                heappush(high, x)
                sh += x
                hs += 1
            if ls > hs:
                v = -heappop(low)
                sl -= v
                heappush(high, v)
                sh += v
                ls -= 1
                hs += 1
            elif hs > ls + 1:
                v = heappop(high)
                sh -= v
                heappush(low, -v)
                sl += v
                hs -= 1
                ls += 1
        print(sh - sl)
        return

    suff = [0] * (n + 1)
    low = []
    high = []
    sl = sh = 0
    ls = hs = 0
    for i in range(n - 1, -1, -1):
        x = a[i]
        if ls == 0 or x <= -low[0]:
            heappush(low, -x)
            sl += x
            ls += 1
        else:
            heappush(high, x)
            sh += x
            hs += 1
        if ls > hs:
            v = -heappop(low)
            sl -= v
            heappush(high, v)
            sh += v
            ls -= 1
            hs += 1
        elif hs > ls + 1:
            v = heappop(high)
            sh -= v
            heappush(low, -v)
            sl += v
            hs -= 1
            ls += 1
        if ((n - i) & 1) == 0:
            suff[i] = sh - sl

    low = []
    high = []
    sl = sh = 0
    ls = hs = 0
    ans = suff[1]
    for i in range(n - 1):
        x = a[i]
        if ls == 0 or x <= -low[0]:
            heappush(low, -x)
            sl += x
            ls += 1
        else:
            heappush(high, x)
            sh += x
            hs += 1
        if ls > hs:
            v = -heappop(low)
            sl -= v
            heappush(high, v)
            sh += v
            ls -= 1
            hs += 1
        elif hs > ls + 1:
            v = heappop(high)
            sh -= v
            heappush(low, -v)
            sl += v
            hs -= 1
            ls += 1
        if (i + 1) & 1 == 0:
            cand = (sh - sl) + suff[i + 2]
            if cand > ans:
                ans = cand
    print(ans)

if __name__ == "__main__":
    solve()
```

