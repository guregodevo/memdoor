Now, `poly_mul`:
```
def poly_mul(a,b,limit=None):
    la=len(a); lb=len(b)
    if la==0 or lb==0: return []
    full=la+lb-1
    need=full if limit is None else min(full,limit)
    if need<=0: return []
    mod=MOD
    if full <= 512 or min(la,lb) <= 16:
        if la > lb:
            a,b=b,a; la,lb=lb,la
        res=[0]*need
        max_i = min(la, need)
        for i in range(max_i):
            ai=a[i]
            if ai:
                maxj = min(lb, need - i)
                for j in range(maxj):
                    res[i+j] += ai * b[j]
        for i in range(need):
            res[i] %= mod
        return res
    L = 1 << (full - 1).bit_length()
    ensure_roots(L)
    fa = a[:] + [0] * (L - la)
    fb = b[:] + [0] * (L - lb)
    ntt(fa, False)
    ntt(fb, False)
    for i in range(L):
        fa[i] = fa[i] * fb[i] % mod
    del fb
    ntt(fa, True, False)
    inv_n = INV_LEN[L.bit_length() - 1]
    return [fa[i] * inv_n % mod for i in range(need)]
```
If `need` > len(fa)? need<=full<=L? full<=L, need<=full, okay.

Now, `alternating_fast`:
```
def alternating_fast(N, fact):
    mod=MOD
    if N <= 1:
        return fact[N]
    H = poly_inv(fact, N)
    s=0
    H_loc=H; fact_loc=fact
    for n in range(N-1):
        s += H_loc[n+1] * fact_loc[N-1-n]
    return (fact_loc[N] + s) % mod
```
Good.

