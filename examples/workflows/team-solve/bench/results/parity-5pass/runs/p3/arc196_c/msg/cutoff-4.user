def cdq_solve(t,b,m,fact,invfact,N):
    mod=MOD
    g=[0]*t
    sacc=[0]*t
    BLOCK=64
    DIRECT_LIMIT=16384
    def cdq(l,r, fl=fact, ml=m, gl=g, sl=sacc, bl=b, invf=invfact, mod=mod, ntt=ntt, ensure_roots=ensure_roots, INV_LEN=INV_LEN):
        if r - l + 1 <= BLOCK:
            for i in range(l, r+1):
                bi=bl[i]
                add=0
                for j in range(l, i):
                    add += gl[j] * fl[bi - ml[j]]
                s = (sl[i] + add) % mod
                val = fl[bi] + s
                if val >= mod: val -= mod
                gl[i] = (mod - val) * invf[bi - ml[i]] % mod
            return
        mid = (l + r) >> 1
        cdq(l, mid)
        ls = mid - l + 1
        rs = r - mid
        direct_cost = ls * rs
        mid1 = mid + 1
        if direct_cost <= DIRECT_LIMIT: