PROBLEM:
### Question
There is a directed graph with 2N vertices and 2N-1 edges.
The vertices are numbered 1, 2, \ldots, 2N, and the i-th edge is a directed edge from vertex i to vertex i+1.
You are given a length-2N string S = S_1 S_2 \ldots S_{2N} consisting of N Ws and N Bs.
Vertex i is colored white if S_i is W, and black if S_i is B.
You will perform the following series of operations:

- Partition the 2N vertices into N pairs, each consisting of one white vertex and one black vertex.
- For each pair, add a directed edge from the white vertex to the black vertex.

Print the number, modulo 998244353, of ways to partition the vertices into N pairs such that the final graph is strongly connected.
 Notes on strongly connectedness
A directed graph is strongly connected if and only if it is possible to travel from any vertex to any vertex by following edges.

Input

The input is given from Standard Input in the following format:
N
S

Output

Print the number, modulo 998244353, of ways to partition the vertices into N pairs so that the final graph is strongly connected.

Constraints


- 1 \le N \le 2\times 10^5
- S is a length 2N string consisting of N Ws and N Bs.
- N is an integer.

Sample Input 1

2
BWBW

Sample Output 1

1

Vertices 2,4 are white, and vertices 1,3 are black.
Let (u,v) denote an edge from vertex u to vertex v.
If we pair up vertices as (2,1), (4,3), the final graph have the edges (1,2), (2,3), (3,4), (2,1), (4,3). In this case, for example, it is impossible to travel from vertex 3 to vertex 1 by following edges, so this graph is not strongly connected.
If we pair up vertices as (2,3), (4,1), the final graph have the edges (1,2), (2,3), (3,4), (2,3), (4,1). This graph is strongly connected.
Therefore, there is exactly 1 way to pair up the vertices that satisfies the condition.

Sample Input 2

4
BWWBWBWB

Sample Output 2

0

No matter how you pair up the vertices, you cannot satisfy the condition.

Sample Input 3

9
BWWBWBBBWWBWBBWWBW

Sample Output 3

240792

### Format: Read the inputs from stdin solve the problem and write the answer to stdout (do not directly test on the sample inputs). Enclose your code within delimiters as follows. Ensure that when the python program runs, it reads the inputs, runs the algorithm and writes output to STDOUT.



PLAN:
```python
import sys

MOD = 998244353
G = 3

def mod_pow(a, e, mod=MOD):
    res = 1
    while e:
        if e & 1:
            res = res * a % mod
        a = a * a % mod
        e >>= 1
    return res

def ntt(a, invert):
    n = len(a)
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            a[i], a[j] = a[j], a[i]

    length = 2
    while length <= n:
        wlen = mod_pow(G, (MOD - 1) // length)
        if invert:
            wlen = mod_pow(wlen, MOD - 2)
        half = length >> 1
        for i in range(0, n, length):
            w = 1
            for j in range(i, i + half):
                u = a[j]
                v = a[j + half] * w % MOD
                x = u + v
                if x >= MOD:
                    x -= MOD
                y = u - v
                if y < 0:
                    y += MOD
                a[j] = x
                a[j + half] = y
                w = w * wlen % MOD
        length <<= 1

    if invert:
        inv_n = mod_pow(n, MOD - 2)
        for i in range(n):
            a[i] = a[i] * inv_n % MOD

def convolution(a, b):
    if not a or not b:
        return []
    need = len(a) + len(b) - 1
    n = 1
    while n < need:
        n <<= 1
    fa = a + [0] * (n - len(a))
    fb = b + [0] * (n - len(b))
    ntt(fa, False)
    ntt(fb, False)
    for i in range(n):
        fa[i] = fa[i] * fb[i] % MOD
    ntt(fa, True)
    return fa[:need]

def solve():
    input = sys.stdin.readline
    N = int(input().strip())
    S = input().strip()

    if S[0] != 'B' or S[-1] != 'W':
        print(0)
        return

    fact = [1] * (N + 1)
    for i in range(1, N + 1):
        fact[i] = fact[i - 1] * i % MOD
    invfact = [1] * (N + 1)
    invfact[N] = mod_pow(fact[N], MOD - 2)
    for i in range(N, 0, -1):
        invfact[i - 1] = invfact[i] * i % MOD

    # R[c] = number of W before black (c+1), for c=1..N-1; R[N] = N-1
    R = [0] * (N + 1)
    w = 0
    b = 0
    for ch in S:
        if ch == 'W':
            w += 1
        else:
            b += 1
            if b >= 2:
                R[b - 1] = w
    R[N] = N - 1

    # A[c] is updated online.  We need queries:
    # Q_c = sum_{t < c} A[t] * fact[R[c] - t]
    # Use CDQ divide and conquer with NTT.
    A = [0] * (N + 1)
    query = [0] * (N + 1)

    def cdq(l, r):
        if l >= r:
            return
        mid = (l + r) // 2
        cdq(l, mid)

        # contributions from t in [l, mid] to c in [mid+1, r]
        left_len = mid - l + 1
        right_len = r - mid
        # A[t] at index t-l
        left = [0] * left_len
        for i in range(l, mid + 1):
            left[i - l] = A[i]
        # fact[R[c] - t] is not a pure convolution unless we shift by c.
        # For each c, t is in [l,mid].  We build an array over t and convolve
        # with fact.  The result at index (R[c] - l) gives sum left[t-l] * fact[R[c]-t].
        # We only need indices up to max R[c] - l.
        max_idx = 0
        for c in range(mid + 1, r + 1):
            if R[c] >= l:
                if R[c] - l > max_idx:
                    max_idx = R[c] - l
        if max_idx >= 0:
            fact_part = fact[:max_idx + 1]
            conv = convolution(left, fact_part)
            for c in range(mid + 1, r + 1):
                idx = R[c] - l
                if 0 <= idx < len(conv):
                    query[c] = (query[c] + conv[idx]) % MOD

        cdq(mid + 1, r)

        for c in range(mid + 1, r + 1):
            if R[c] >= c:
                val = (fact[R[c]] + query[c]) % MOD
                A[c] = (-val * invfact[R[c] - c]) % MOD

    cdq(1, N)

    ans = fact[N]
    for c in range(1, N + 1):
        if A[c]:
            ans = (ans + A[c] * fact[N - c]) % MOD
    print(ans % MOD)

if __name__ == "__main__":
    solve()
```

NOTES:
- **Sample verification:** The program produces `1` for sample 1 (`N=2`, `BWBW`), `0` for sample 2 (`N=4`, `BWWBWBWB`, last character is `B`), and `240792` for sample 3 (`N=9`, `BWWBWBBBWWBWBBWWBW`).
- **Strong connectivity criterion:** With the base path `1 -> 2 -> ... -> 2N`, the graph is strongly connected iff for every cut `k`, there is at least one added edge from a vertex `> k` to a vertex `<= k`. Since added edges go only from white to black, this means for every prefix with `c` black vertices and `w` white vertices, at least one of the first `c` black vertices is matched to a white vertex after the prefix.
- **Reduction to events:** Let `R[c]` be the number of white vertices before black `c+1`, and set `R[N]=N-1`. For the `c` black vertices, the hardest cut in that block has `R[c]` whites. The bad event is `E_c`: the first `c` black vertices are matched only to the first `R[c]` white vertices. If `R[c]` is constant over a run of `c`, only the first `c` in that run matters, because later events imply it. Nonempty events require `R[c] >= c`.
- **Inclusion-exclusion DP:** Let the kept events be indexed by increasing `c_i, r_i`. For a subset whose maximum kept index is `i`, the number of matchings satisfying that subset is `fact[N-c_i] * product fact[r_j - c_prev] / fact[r_j - c_j]`. Define `A[i]` as the signed inclusion-exclusion sum for subsets ending at `i`. Then
  `A[i] = -(fact[r_i] + sum_{j<i} A[j] * fact[r_i - c_j]) / fact[r_i - c_i]`.
  The answer is `fact[N] + sum_i A[i] * fact[N - c_i]`.
- **CDQ/NTT computation:** The recurrence is triangular but the query sum is a shifted factorial convolution. CDQ divide-and-conquer is used: after the left half is solved, contributions from left indices to right indices are added. For a node, left terms are placed by their actual `c` coordinate, and the factorial segment is taken over the needed difference range `[min_diff, max_diff]`; one convolution gives all right-side query additions.
- **Implementation details:** Endpoint check `S[0]=='B'` and `S[-1]=='W'` is necessary. Small `M` uses direct O(M^2). For larger `M`, NTT is used with DIF forward and DIT inverse transforms, avoiding explicit bit-reversal. The maximum NTT size is bounded by `2N+5`.
- **Status:** Samples are verified; the algorithm is complete for the stated constraints, but large stress/performance testing is still the natural next step.


CURRENT WORK:
import sys

MOD = 998244353
G = 3


def solve():
    input = sys.stdin.readline
    line = input().strip()
    if not line:
        return
    N = int(line)
    S = input().strip()

    # Necessary endpoint conditions for strong connectivity.
    if S[0] != 'B' or S[-1] != 'W':
        print(0)
        return

    fact = [1] * (N + 1)
    for i in range(1, N + 1):
        fact[i] = fact[i - 1] * i % MOD

    invfact = [1] * (N + 1)
    invfact[N] = pow(fact[N], MOD - 2, MOD)
    for i in range(N, 0, -1):
        invfact[i - 1] = invfact[i] * i % MOD

    # R[c] = number of white vertices before black vertex c+1, for c=1..N-1.
    # R[N] = N-1 (the last cut before the final white vertex).
    R = [0] * (N + 1)
    w = 0
    b = 0
    for ch in S:
        if ch == 'W':
            w += 1
        else:
            b += 1
            if b >= 2:
                R[b - 1] = w
    R[N] = N - 1

    # For each distinct value r of R, only the first c with R[c]=r matters.
    # The bad event is: first c black vertices are matched only to first r white vertices.
    c_arr = []
    r_arr = []
    prev = -1
    for c in range(1, N + 1):
        r = R[c]
        if r > prev:
            if r >= c:
                c_arr.append(c)
                r_arr.append(r)
            prev = r

    del R, S

    M = len(c_arr)
    ans = fact[N]
    if M == 0:
        print(ans % MOD)
        return

    mod = MOD
    f = fact
    inv = invfact
    c = c_arr
    r = r_arr

    # Small case: direct O(M^2) is faster and avoids NTT overhead.
    if M <= 4000:
        A = [0] * M
        for i in range(M):
            ri = r[i]
            s = 0
            for j in range(i):
                s += A[j] * f[ri - c[j]]
            s %= mod
            val = f[ri] + s
            if val >= mod:
                val -= mod
            A[i] = (mod - val) * inv[ri - c[i]] % mod

        ans = f[N]
        for i in range(M):
            ans = (ans + A[i] * f[N - c[i]]) % mod
        print(ans)
        return

    # NTT setup.  The largest needed convolution length is < 2N.
    max_n = 1
    while max_n < 2 * N + 5:
        max_n <<= 1
    max_log = max_n.bit_length() - 1

    root = [0] * (max_log + 1)
    iroot = [0] * (max_log + 1)
    inv_len = [1] * (max_log + 1)
    inv2 = (mod + 1) // 2
    for k in range(1, max_log + 1):
        length = 1 << k
        root[k] = pow(G, (mod - 1) // length, mod)
        iroot[k] = pow(root[k], mod - 2, mod)
        inv_len[k] = inv_len[k - 1] * inv2 % mod

    # DIF forward NTT: natural input, bit-reversed output.
    def ntt(a):
        n = len(a)
        if n == 1:
            return
        length = n
        k = n.bit_length() - 1
        while length > 1:
            half = length >> 1
            wlen = root[k]
            for i in range(0, n, length):
                w = 1
                j = i
                jj = i + half
                end = i + half
                while j < end:
                    u = a[j]
                    v = a[jj]
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[j] = x
                    a[jj] = y * w % mod
                    w = w * wlen % mod
                    j += 1
                    jj += 1
            length = half
            k -= 1

    # DIT inverse NTT: bit-reversed input, natural output.
    def intt(a):
        n = len(a)
        if n == 1:
            return
        length = 2
        k = 1
        while length <= n:
            half = length >> 1
            wlen = iroot[k]
            for i in range(0, n, length):
                w = 1
                j = i
                jj = i + half
                end = i + half
                while j < end:
                    u = a[j]
                    v = a[jj] * w % mod
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[j] = x
                    a[jj] = y
                    w = w * wlen % mod
                    j += 1
                    jj += 1
            length <<= 1
            k += 1
        inv_n = inv_len[n.bit_length() - 1]
        for i in range(n):
            a[i] = a[i] * inv_n % mod

    A = [0] * M
    query = [0] * M

    T = 128
    DIRECT = 16384
    sys.setrecursionlimit(1_000_000)

    def add_convolution(l, mid, rr):
        # Add sum_{j in [l,mid)} A[j] * fact[r[i]-c[j]] to query[i] for i in [mid,rr).
        c_l = c[l]
        c_mid = c[mid - 1]
        Clen = c_mid - c_l + 1

        min_diff = r[mid] - c_mid
        max_diff = r[rr - 1] - c_l
        Flen = max_diff - min_diff + 1

        need = Clen + Flen - 1
        n = 1 << (need - 1).bit_length()

        fa = [0] * n
        for j in range(l, mid):
            fa[c[j] - c_l] = A[j]

        fb = [0] * n
        fb[:Flen] = f[min_diff:min_diff + Flen]

        ntt(fa)
        ntt(fb)
        for i in range(n):
            fa[i] = fa[i] * fb[i] % mod
        del fb
        intt(fa)

        base = -c_l - min_diff
        for i in range(mid, rr):
            idx = r[i] + base
            val = query[i] + fa[idx]
            if val >= mod:
                val -= mod
            query[i] = val

    def cdq(l, rr):
        if rr - l <= T:
            for i in range(l, rr):
                ri = r[i]
                s = query[i]
                for j in range(l, i):
                    s += A[j] * f[ri - c[j]]
                s %= mod
                val = f[ri] + s
                if val >= mod:
                    val -= mod
                A[i] = (mod - val) * inv[ri - c[i]] % mod
            return

        mid = (l + rr) >> 1
        cdq(l, mid)

        left_len = mid - l
        right_len = rr - mid
        if left_len * right_len <= DIRECT:
            for i in range(mid, rr):
                ri = r[i]
                s = query[i]
                for j in range(l, mid):
                    s += A[j] * f[ri - c[j]]
                s %= mod
                query[i] = s
        else:
            add_convolution(l, mid, rr)

        cdq(mid, rr)

    cdq(0, M)

    ans = f[N]
    for i in range(M):
        ans = (ans + A[i] * f[N - c[i]]) % mod
    print(ans)


if __name__ == "__main__":
    solve()

