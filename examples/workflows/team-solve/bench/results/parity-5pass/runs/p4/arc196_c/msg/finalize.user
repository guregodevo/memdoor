PROBLEM:
### Question
There is a directed graph with 2N vertices and 2N-1 edges.
The vertices are numbered 1, 2, \ldots, 2N, and the i-th edge is a directed edge from vertex i to vertex i+1.
You are given a length-2N string S = S_1 S_2 \ldots S_{2N} consisting of N Ws and N Bs.
Vertex i is colored white if S_i is W, and black if S_i is B.
You will perform the following series of operations:

- Partition the 2N vertices into N pairs, each consisting of one white vertex and one black vertex.
- For each pair, add a directed edge from the white vertex to the black vertex.

Print the number, modulo 998244353, of ways to partition the vertices into N pairs such that the final graph is strongly connected.
 Notes on strongly connectedness
A directed graph is strongly connected if and only if it is possible to travel from any vertex to any vertex by following edges.

Input

The input is given from Standard Input in the following format:
N
S

Output

Print the number, modulo 998244353, of ways to partition the vertices into N pairs so that the final graph is strongly connected.

Constraints


- 1 \le N \le 2\times 10^5
- S is a length 2N string consisting of N Ws and N Bs.
- N is an integer.

Sample Input 1

2
BWBW

Sample Output 1

1

Vertices 2,4 are white, and vertices 1,3 are black.
Let (u,v) denote an edge from vertex u to vertex v.
If we pair up vertices as (2,1), (4,3), the final graph have the edges (1,2), (2,3), (3,4), (2,1), (4,3). In this case, for example, it is impossible to travel from vertex 3 to vertex 1 by following edges, so this graph is not strongly connected.
If we pair up vertices as (2,3), (4,1), the final graph have the edges (1,2), (2,3), (3,4), (2,3), (4,1). This graph is strongly connected.
Therefore, there is exactly 1 way to pair up the vertices that satisfies the condition.

Sample Input 2

4
BWWBWBWB

Sample Output 2

0

No matter how you pair up the vertices, you cannot satisfy the condition.

Sample Input 3

9
BWWBWBBBWWBWBBWWBW

Sample Output 3

240792

### Format: Read the inputs from stdin solve the problem and write the answer to stdout (do not directly test on the sample inputs). Enclose your code within delimiters as follows. Ensure that when the python program runs, it reads the inputs, runs the algorithm and writes output to STDOUT.



PLAN:
```python
import sys

MOD = 998244353
G = 3

def mod_pow(a, e, mod=MOD):
    res = 1
    while e:
        if e & 1:
            res = res * a % mod
        a = a * a % mod
        e >>= 1
    return res

def ntt(a, invert):
    n = len(a)
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            a[i], a[j] = a[j], a[i]

    length = 2
    while length <= n:
        wlen = mod_pow(G, (MOD - 1) // length)
        if invert:
            wlen = mod_pow(wlen, MOD - 2)
        half = length >> 1
        for i in range(0, n, length):
            w = 1
            for j in range(i, i + half):
                u = a[j]
                v = a[j + half] * w % MOD
                x = u + v
                if x >= MOD:
                    x -= MOD
                y = u - v
                if y < 0:
                    y += MOD
                a[j] = x
                a[j + half] = y
                w = w * wlen % MOD
        length <<= 1

    if invert:
        inv_n = mod_pow(n, MOD - 2)
        for i in range(n):
            a[i] = a[i] * inv_n % MOD

def convolution(a, b):
    if not a or not b:
        return []
    need = len(a) + len(b) - 1
    n = 1
    while n < need:
        n <<= 1
    fa = a + [0] * (n - len(a))
    fb = b + [0] * (n - len(b))
    ntt(fa, False)
    ntt(fb, False)
    for i in range(n):
        fa[i] = fa[i] * fb[i] % MOD
    ntt(fa, True)
    return fa[:need]

def solve():
    input = sys.stdin.readline
    N = int(input().strip())
    S = input().strip()

    if S[0] != 'B' or S[-1] != 'W':
        print(0)
        return

    fact = [1] * (N + 1)
    for i in range(1, N + 1):
        fact[i] = fact[i - 1] * i % MOD
    invfact = [1] * (N + 1)
    invfact[N] = mod_pow(fact[N], MOD - 2)
    for i in range(N, 0, -1):
        invfact[i - 1] = invfact[i] * i % MOD

    # R[c] = number of W before black (c+1), for c=1..N-1; R[N] = N-1
    R = [0] * (N + 1)
    w = 0
    b = 0
    for ch in S:
        if ch == 'W':
            w += 1
        else:
            b += 1
            if b >= 2:
                R[b - 1] = w
    R[N] = N - 1

    # A[c] is updated online.  We need queries:
    # Q_c = sum_{t < c} A[t] * fact[R[c] - t]
    # Use CDQ divide and conquer with NTT.
    A = [0] * (N + 1)
    query = [0] * (N + 1)

    def cdq(l, r):
        if l >= r:
            return
        mid = (l + r) // 2
        cdq(l, mid)

        # contributions from t in [l, mid] to c in [mid+1, r]
        left_len = mid - l + 1
        right_len = r - mid
        # A[t] at index t-l
        left = [0] * left_len
        for i in range(l, mid + 1):
            left[i - l] = A[i]
        # fact[R[c] - t] is not a pure convolution unless we shift by c.
        # For each c, t is in [l,mid].  We build an array over t and convolve
        # with fact.  The result at index (R[c] - l) gives sum left[t-l] * fact[R[c]-t].
        # We only need indices up to max R[c] - l.
        max_idx = 0
        for c in range(mid + 1, r + 1):
            if R[c] >= l:
                if R[c] - l > max_idx:
                    max_idx = R[c] - l
        if max_idx >= 0:
            fact_part = fact[:max_idx + 1]
            conv = convolution(left, fact_part)
            for c in range(mid + 1, r + 1):
                idx = R[c] - l
                if 0 <= idx < len(conv):
                    query[c] = (query[c] + conv[idx]) % MOD

        cdq(mid + 1, r)

        for c in range(mid + 1, r + 1):
            if R[c] >= c:
                val = (fact[R[c]] + query[c]) % MOD
                A[c] = (-val * invfact[R[c] - c]) % MOD

    cdq(1, N)

    ans = fact[N]
    for c in range(1, N + 1):
        if A[c]:
            ans = (ans + A[c] * fact[N - c]) % MOD
    print(ans % MOD)

if __name__ == "__main__":
    solve()
```

NOTES:
- **Endpoint condition:** Strong connectivity is impossible unless vertex 1 is black and vertex 2N is white. This is checked first and immediately returns 0 otherwise.
- **Cut characterization:** With the base path 1 -> 2 -> ... -> 2N, the graph is strongly connected iff every cut has at least one added edge from right to left. For a prefix containing c black vertices and w white vertices, this means at least one of the first c black vertices is paired with a white vertex after the prefix.
- **Event reduction:** For c = 1..N-1, let R[c] be the number of white vertices before black c+1. The hardest cut with c black vertices has w = R[c]. The bad event E_c is that the first c black vertices are paired only with the first R[c] white vertices. If R[c] < c, E_c is impossible. If R is constant over several c, only the first such c matters because later events are subsets of the earlier one.
- **Inclusion-exclusion DP:** For kept events (c_i, r_i), sorted increasingly, define A[i] as the signed inclusion-exclusion sum for subsets whose maximum kept index is i. Then  
  `A[i] = -(fact[r_i] + sum_{j<i} A[j] * fact[r_i - c_j]) / fact[r_i - c_i]`.  
  The answer is `fact[N] + sum_i A[i] * fact[N - c_i]`.
- **CDQ divide and conquer:** The recurrence is triangular. CDQ computes contributions from the left half to the right half. For a node, left terms are placed by actual c-coordinate, and a factorial segment is convolved to update all right-side query sums. This gives the needed shifted factorial convolution.
- **Direct threshold:** The direct O(M^2) solver is forced to be used only for M <= 2000 by `DIRECT_M = 2000`. A conservative adaptive fallback may still choose direct for M up to 4000 when the active c/r span is much smaller than N, but random/structured stress cases with N=3000..10000 and M>2000 use the large CDQ path.
- **Stress testing:** Compared the direct solver and the CDQ/NTT solver on random strings and structured strings (alternating, blocky, large jumps) in the requested N=3000..10000 range with active M>2000. No correctness mismatches were found.
- **NTT implementation:** Uses DIF forward and DIT inverse transforms with precomputed twiddle factors, avoiding per-butterfly twiddle updates. The transform size is bounded by the active c/r span, not always by 2N, which keeps memory and time lower for localized event ranges.
- **Indexing in convolution:** For a CDQ node, `min_diff = r[mid] - c[mid-1]` and `max_diff = r[right-1] - c[l]`. The convolution index for right event i is `r[i] - c[l] - min_diff`. This was verified against the direct recurrence on small and medium random cases.
- **Samples:** Sample 1 gives 1, sample 2 gives 0 by endpoint check, and sample 3 gives 240792 with the direct path.


CURRENT WORK:
import sys

MOD = 998244353
G = 3
DIRECT_M = 2000


def extract_events(N, S):
    c_arr = []
    r_arr = []
    prev = -1
    w = 0
    b = 0
    W = 87  # ord('W')

    for ch in S:
        if ch == W:
            w += 1
        else:
            b += 1
            if b >= 2:
                c = b - 1
                r = w
                if r > prev:
                    if r >= c:
                        c_arr.append(c)
                        r_arr.append(r)
                    prev = r
    return c_arr, r_arr


def solve_direct(N, c_arr, r_arr, fact, invfact):
    mod = MOD
    M = len(c_arr)
    A = [0] * M
    f = fact
    inv = invfact
    cc = c_arr
    rr = r_arr

    for i in range(M):
        ri = rr[i]
        s = 0
        for j in range(i):
            s += A[j] * f[ri - cc[j]]
        s %= mod
        val = f[ri] + s
        if val >= mod:
            val -= mod
        A[i] = (mod - val) * inv[ri - cc[i]] % mod

    ans = f[N]
    for i in range(M):
        ans = (ans + A[i] * f[N - cc[i]]) % mod
    return ans


def build_roots(max_n):
    mod = MOD
    max_log = max_n.bit_length() - 1
    roots = [None] * (max_log + 1)
    iroots = [None] * (max_log + 1)
    inv_len = [1] * (max_log + 1)
    inv2 = (mod + 1) // 2

    for k in range(1, max_log + 1):
        length = 1 << k
        half = length >> 1
        wlen = pow(G, (mod - 1) // length, mod)

        rw = [1] * half
        for i in range(1, half):
            rw[i] = rw[i - 1] * wlen % mod
        roots[k] = rw

        iwlen = pow(wlen, mod - 2, mod)
        irw = [1] * half
        for i in range(1, half):
            irw[i] = irw[i - 1] * iwlen % mod
        iroots[k] = irw

        inv_len[k] = inv_len[k - 1] * inv2 % mod

    return roots, iroots, inv_len


def solve_large(N, c_arr, r_arr, fact, invfact):
    mod = MOD
    M = len(c_arr)

    c0 = c_arr[0]
    max_need_bound = (c_arr[-1] - c0 + 1) + (r_arr[-1] - c0 + 1) + 5
    max_n = 1
    while max_n < max_need_bound:
        max_n <<= 1

    roots, iroots, inv_len = build_roots(max_n)

    A = [0] * M
    query = [0] * M
    f = fact
    inv = invfact
    cc = c_arr
    rr_arr = r_arr

    T = 128
    DIRECT = 16384
    sys.setrecursionlimit(1_000_000)

    def ntt(a, roots=roots, mod=mod):
        n = len(a)
        if n == 1:
            return

        length = n
        k = n.bit_length() - 1
        while length > 1:
            half = length >> 1
            if half == 1:
                for i in range(0, n, 2):
                    u = a[i]
                    v = a[i + 1]
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[i] = x
                    a[i + 1] = y
            else:
                ws = roots[k]
                rng = range(1, half)
                for i in range(0, n, length):
                    p = i
                    q = i + half
                    u = a[p]
                    v = a[q]
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[p] = x
                    a[q] = y

                    for j in rng:
                        p = i + j
                        q = p + half
                        u = a[p]
                        v = a[q]
                        x = u + v
                        if x >= mod:
                            x -= mod
                        y = u - v
                        if y < 0:
                            y += mod
                        a[p] = x
                        a[q] = y * ws[j] % mod

            length = half
            k -= 1

    def intt(a, iroots=iroots, inv_len=inv_len, mod=mod):
        n = len(a)
        if n == 1:
            return a

        length = 2
        k = 1
        while length <= n:
            half = length >> 1
            if half == 1:
                for i in range(0, n, 2):
                    u = a[i]
                    v = a[i + 1]
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[i] = x
                    a[i + 1] = y
            else:
                ws = iroots[k]
                rng = range(1, half)
                for i in range(0, n, length):
                    p = i
                    q = i + half
                    u = a[p]
                    v = a[q]
                    x = u + v
                    if x >= mod:
                        x -= mod
                    y = u - v
                    if y < 0:
                        y += mod
                    a[p] = x
                    a[q] = y

                    for j in rng:
                        p = i + j
                        q = p + half
                        u = a[p]
                        v = a[q] * ws[j] % mod
                        x = u + v
                        if x >= mod:
                            x -= mod
                        y = u - v
                        if y < 0:
                            y += mod
                        a[p] = x
                        a[q] = y

            length <<= 1
            k += 1

        inv_n = inv_len[n.bit_length() - 1]
        return [x * inv_n % mod for x in a]

    def add_convolution(l, mid, right,
                        f=f, cc=cc, rr_arr=rr_arr,
                        A=A, query=query,
                        ntt=ntt, intt=intt, mod=mod):
        c_l = cc[l]
        c_mid = cc[mid - 1]
        Clen = c_mid - c_l + 1

        min_diff = rr_arr[mid] - c_mid
        max_diff = rr_arr[right - 1] - c_l
        Flen = max_diff - min_diff + 1

        need = Clen + Flen - 1
        n = 1 << (need - 1).bit_length()

        fa = [0] * n
        for j in range(l, mid):
            fa[cc[j] - c_l] = A[j]

        fb = f[min_diff:min_diff + Flen]
        if len(fb) < n:
            fb += [0] * (n - len(fb))

        ntt(fa)
        ntt(fb)
        fa = [x * y % mod for x, y in zip(fa, fb)]
        del fb
        fa = intt(fa)

        base = -c_l - min_diff
        for i in range(mid, right):
            idx = rr_arr[i] + base
            val = query[i] + fa[idx]
            if val >= mod:
                val -= mod
            query[i] = val

    def cdq(l, right,
            A=A, query=query, f=f, inv=inv,
            cc=cc, rr_arr=rr_arr, mod=mod,
            T=T, DIRECT=DIRECT, add=add_convolution):
        if right - l <= T:
            for i in range(l, right):
                ri = rr_arr[i]
                s = query[i]
                for j in range(l, i):
                    s += A[j] * f[ri - cc[j]]
                s %= mod
                val = f[ri] + s
                if val >= mod:
                    val -= mod
                A[i] = (mod - val) * inv[ri - cc[i]] % mod
            return

        mid = (l + right) >> 1
        cdq(l, mid)

        left_len = mid - l
        right_len = right - mid

        if left_len * right_len <= DIRECT:
            for i in range(mid, right):
                ri = rr_arr[i]
                s = query[i]
                for j in range(l, mid):
                    s += A[j] * f[ri - cc[j]]
                s %= mod
                query[i] = s
        else:
            add(l, mid, right)

        cdq(mid, right)

    cdq(0, M)

    ans = f[N]
    for i in range(M):
        ans = (ans + A[i] * f[N - cc[i]]) % mod
    return ans


def should_use_direct(M, N, c_arr, r_arr):
    if M <= DIRECT_M:
        return True

    if M <= 4000:
        direct_ops = M * (M - 1) // 2
        span = (c_arr[-1] - c_arr[0]) + (r_arr[-1] - c_arr[0])
        base = max(M, span)
        ntt_ops = (base + M) * M.bit_length() * max(1, (2 * base + M).bit_length())
        if direct_ops * 2 <= ntt_ops:
            return True

    return False


def solve():
    data = sys.stdin.buffer.read().split()
    if not data:
        return

    N = int(data[0])
    S = data[1]

    if S[0] != 66 or S[-1] != 87:
        print(0)
        return

    c_arr, r_arr = extract_events(N, S)
    M = len(c_arr)

    fact = [1] * (N + 1)
    for i in range(1, N + 1):
        fact[i] = fact[i - 1] * i % MOD

    if M == 0:
        print(fact[N] % MOD)
        return

    invfact = [1] * (N + 1)
    invfact[N] = pow(fact[N], MOD - 2, MOD)
    for i in range(N, 0, -1):
        invfact[i - 1] = invfact[i] * i % MOD

    if should_use_direct(M, N, c_arr, r_arr):
        ans = solve_direct(N, c_arr, r_arr, fact, invfact)
    else:
        ans = solve_large(N, c_arr, r_arr, fact, invfact)

    print(ans % MOD)


if __name__ == "__main__":
    solve()

