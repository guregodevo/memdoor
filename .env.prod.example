# Memdoor production environment.
# Copy to .env and fill in values: cp .env.prod.example .env
#
# Every model call runs on a provider key (OPEN_ROUTER_API_KEY, a vendor key,
# or a company AI gateway); there is no local model.

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# Public URL — used in email links and invite tokens.
BASE_URL=https://memdoor.ai

# Email provider for invites + notifications.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@memdoor.ai

# The seat: Stripe price id of the $10/month Pro plan (and the yearly one, if sold).
# Without it "Get a seat" answers "no stripe price configured" (2026-09-18).
STRIPE_PRO_MONTHLY_PRICE=price_your_monthly_seat
STRIPE_PRO_YEARLY_PRICE=
